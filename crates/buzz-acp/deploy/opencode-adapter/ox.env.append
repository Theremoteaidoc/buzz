# WO #598 — append these two lines to /opt/buzz/personas/ox.env if missing.
# OPENCODE_TIMEOUT_SECS must equal BUZZ_ACP_MAX_TURN_DURATION so the Python
# wrapper cannot kill the turn 15 minutes before the seat's configured ceiling.
# Secrets stay in the host env file (scp, not git).
BUZZ_ACP_MAX_TURN_DURATION=2400
OPENCODE_TIMEOUT_SECS=2400
